{
  "id": "claude-code",
  "version": "1.2.0",
  "name": "Claude Code with Sandbox",
  "description": "Installs Claude Code CLI, sandbox dependencies (bubblewrap, socat, ripgrep), and voice-mode audio support (sox, PulseAudio/PipeWire). Runs privileged and mounts Claude credential/config files and the host PulseAudio socket.",
  "documentationURL": "https://code.claude.com/docs/en/sandboxing",
  "options": {
    "version": {
      "type": "string",
      "default": "latest",
      "description": "Version of Claude Code to install ('latest', 'stable', or a specific version number)"
    }
  },
  "privileged": true,
  "mounts": [
    {
      "type": "bind",
      "source": "${localEnv:HOME}/.claude",
      "target": "/home/vscode/.claude"
    },
    {
      "type": "bind",
      "source": "${localEnv:HOME}/.claude.json",
      "target": "/home/vscode/.claude.json"
    },
    {
      "type": "bind",
      "source": "${localEnv:HOME}/.config/claude-code",
      "target": "/home/vscode/.config/claude-code"
    },
    {
      "type": "bind",
      "source": "${localEnv:XDG_RUNTIME_DIR:/run/user/1000}/pulse",
      "target": "/run/user/1000/pulse"
    }
  ],
  "containerEnv": {
    "CLAUDE_CODE_DISABLE_NONINTERACTIVE": "1",
    "PULSE_SERVER": "unix:/run/user/1000/pulse/native",
    "AUDIODRIVER": "pulseaudio"
  },
  "dependsOn": {
    "ghcr.io/devcontainers/features/node:1": {}
  },
  "installsAfter": [
    "ghcr.io/devcontainers/features/common-utils",
    "ghcr.io/devcontainers/features/node"
  ]
}
